{
  "name": "english-note",
  "version": "1.0.0",
  "type": "module",
  "description": "高考英语语法知识库与复习指南",
  "dependencies": {
    "blueimp-md5": "^2.19.0",
    "qrcode.vue": "^3.9.1"
  },
  "devDependencies": {
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^25.9.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "markdown-it-mathjax3": "^4.3.2",
    "medium-zoom": "^1.1.0",
    "oxfmt": "^0.50.0",
    "playwright": "^1.60.0",
    "schema-dts": "^1.1.5",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.18",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:visual": "node scripts/visual-qa.js",
    "pdf:single": "node scripts/export-pdf.js --list scripts/pdf-repo-test.txt --out-dir pdf-repo-single --concurrency 1",
    "pdf:all": "node scripts/export-pdf.js --concurrency 4",
    "pdf:package": "node scripts/package-pdf.js"
  }
}